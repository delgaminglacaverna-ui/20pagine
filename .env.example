UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-server-only-token

# Panel: configure these only in Vercel environment variables, never in HTML.
PANEL_PASSWORD=choose-your-private-password
PANEL_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional AI wording for the move coach: server-only, never in browser code.
# Without this key the coach API uses deterministic engine facts.
OPENAI_API_KEY=
COACH_MODEL=gpt-4.1-mini
