{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/matches.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/morte",
      "destination": "/mortis.html"
    },
    {
      "source": "/morte/",
      "destination": "/mortis.html"
    },
    {
      "source": "/mortis",
      "destination": "/mortis.html"
    },
    {
      "source": "/mortis/",
      "destination": "/mortis.html"
    },
    {
      "source": "/memento-mori",
      "destination": "/mortis.html"
    },
    {
      "source": "/memento-mori/",
      "destination": "/mortis.html"
    },
    {
      "source": "/mementomori",
      "destination": "/mortis.html"
    },
    {
      "source": "/mementomori/",
      "destination": "/mortis.html"
    },
    {
      "source": "/memento mori",
      "destination": "/mortis.html"
    },
    {
      "source": "/memento mori/",
      "destination": "/mortis.html"
    },
    {
      "source": "/dash",
      "destination": "/index.html"
    },
    {
      "source": "/dash/",
      "destination": "/index.html"
    },
    {
      "source": "/french",
      "destination": "/index.html"
    },
    {
      "source": "/french/",
      "destination": "/index.html"
    },
    {
      "source": "/boring",
      "destination": "/boring.html"
    },
    {
      "source": "/boring/",
      "destination": "/boring.html"
    },
    {
      "source": "/risio",
      "destination": "/index.html"
    },
    {
      "source": "/risio/",
      "destination": "/index.html"
    },
    {
      "source": "/panel",
      "destination": "/panel.html"
    },
    {
      "source": "/panel/",
      "destination": "/panel.html"
    },
    {
      "source": "/api/matches/:id/:action",
      "destination": "/api/matches?id=:id&action=:action"
    },
    {
      "source": "/api/matches/:id",
      "destination": "/api/matches?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/panel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/panel/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/panel.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/gd",
      "destination": "/dash",
      "permanent": true
    },
    {
      "source": "/gd/",
      "destination": "/dash",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "version",
          "value": "french"
        }
      ],
      "destination": "/french",
      "permanent": true
    }
  ]
}
